# =====================================================================
# SaydiTool Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env to git.
# =====================================================================

# Worker settings
CRAWLER_WORKERS=4
ASR_TARGET_MODEL=balanced

# Cloud Speech API keys (Optional)
CLOUD_SPEECH_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Google Drive Remote
GDRIVE_REMOTE=gdrive:Dataset
